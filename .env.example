# Copy to .env and edit. Nothing here is required except the admin login.

# --- First login --------------------------------------------------------
# Created on first start only, if no users exist yet. Change the password
# after signing in, or remove these two lines afterwards.
STACKS_ADMIN_USER=admin
STACKS_ADMIN_PASSWORD=change-me-please

# --- Hostname and HTTPS -------------------------------------------------
# Comma-separated hostnames you will visit the app at.
STACKS_ALLOWED_HOSTS=localhost
# Needed when serving over HTTPS behind a reverse proxy.
# STACKS_CSRF_TRUSTED_ORIGINS=https://books.example.com
# Set to true when a proxy terminates TLS (secure cookies, HSTS).
# STACKS_HTTPS=true

# --- Optional -----------------------------------------------------------
# Host port for the bundled compose file.
# STACKS_PORT=8000
# Fixed secret key. If unset, one is generated once and kept in the data volume.
# STACKS_SECRET_KEY=
# IANA time zone, e.g. America/New_York
# STACKS_TIME_ZONE=UTC
# Open Library asks API users to identify themselves; an email or URL is fine.
# STACKS_CONTACT=you@example.com
# STACKS_LOG_LEVEL=INFO
